{
  "name": "dsh-linguista",
  "version": "0.6.3",
  "private": true,
  "type": "module",
  "description": "Linguista 阅读工作台：跨站 RSS 正文阅读与 DSH 原生 AI 伴读。",
  "license": "UNLICENSED",
  "author": "Linguage",
  "icon": "./icon.svg",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "web",
    "skills",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "VALIDATION.md",
    "UPSTREAM.md",
    "CONTENT-SOURCES.json"
  ],
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.0-0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/check-browser.mjs",
    "test:rss": "node scripts/check-rss-browser.mjs",
    "serve": "node scripts/serve.mjs",
    "package": "node scripts/package.mjs",
    "test:identities": "node scripts/check-identities-browser.mjs",
    "test:mobile": "node scripts/check-mobile-browser.mjs",
    "test:sidebar": "node scripts/check-sidebar-host.mjs",
    "test:web-browser": "node scripts/check-web-browser-host.mjs",
    "test:settings": "node scripts/check-settings-host.mjs"
  }
}
